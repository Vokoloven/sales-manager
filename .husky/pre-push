local_branch_name="$(git rev-parse --abbrev-ref HEAD)"

valid_branch_regex="^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)/([a-z0-9]+([_-][a-z0-9]+)*)+$"

message="❌ Invalid branch name '$local_branch_name'
Valid examples:
  feat/add-google-login
  fix/handle-rate-limit
  refactor/migrate-to-tree-sitter
  chore/update-deps
"

if ! echo "$local_branch_name" | grep -E "$valid_branch_regex" > /dev/null; then
  echo "$message"
  exit 1
fi

exit 0
